# Same token and webhook secret as the Next.js .env.local.
WHATSAPP_WORKER_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
# Permanent encryption key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it in a secret manager; losing it means re-pairing all sessions.
WHATSAPP_SESSION_KEY=
# Docker Compose web service; no public webhook tunnel needed.
WHATSAPP_WEBHOOK_URL=http://web:3000/api/webhooks/whatsapp
